  "concepts": [
    {
      "id": "function_calls",
      "definition": "Follow arguments, return values, and execution across function calls."
    },
    {
      "id": "call_stack",
      "definition": "Track active calls and how returns unwind them."
    },
    {
      "id": "base_cases",
      "definition": "Identify stopping conditions and boundary behavior in recursion."
    },
    {
      "id": "recursive_progress",
      "definition": "Verify that recursive calls move toward a stopping condition."
    },
    {
      "id": "recursive_tracing",
      "definition": "Trace a recursive computation using calls, progress, and base cases."
    },
    {
      "id": "recurrence_relations",
      "definition": "Express a problem in terms of smaller instances and boundary conditions."
    },
    {
      "id": "overlapping_subproblems",
      "definition": "Recognize repeated equivalent subproblems."
    },
    {
      "id": "state_definition",
      "definition": "Define the information needed to identify a subproblem."
    },
    {
      "id": "state_transitions",
      "definition": "Relate a state to the states used to compute it."
    },
    {
      "id": "dp_base_cases",
      "definition": "Initialize valid boundary states in a DP formulation."
    },
    {
      "id": "memoization",
      "definition": "Cache results using a correct state key in top-down evaluation."
    },
    {
      "id": "tabulation",
      "definition": "Evaluate DP states in an order that makes dependencies available."
    }
  ],
