# Runtime: use a least-privilege login granted learngraph_runtime.
# Supabase runtime URL: shared transaction pooler; keep credentials local.
DATABASE_URL=
# Admin/session-compatible connection, used ONLY by scripts/manage_db.py.
MIGRATION_DATABASE_URL=
APP_ENV=development
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Generate at least 32 random characters privately. Never commit its value.
CLIENT_ID_HASH_SECRET=
RELEASE_ID=phase1-v1
# Full analysis activation is separate from the legacy bootstrap release.
ANALYSIS_RELEASE_ID=
# For full-v1 activation retain review-v1 explicitly; at most two releases are supported.
RETAINED_ANALYSIS_RELEASE_IDS=
QUOTA_NAMESPACE=development
